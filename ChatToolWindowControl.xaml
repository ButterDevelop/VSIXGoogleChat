<UserControl x:Class="VSIXGoogleChat.ChatToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="InternalPowerShell"
             FontFamily="pack://application:,,,/VSIXGoogleChat;component/Fonts/CascadiaMono.ttf#Cascadia Mono"
             FontWeight="SemiBold"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <SolidColorBrush  x:Key="TerminalForeground">#FAFAFA</SolidColorBrush>
    </UserControl.Resources>
    <Grid Margin="5" Background="Transparent" PreviewMouseDown="PreviewMouseDown" PreviewKeyDown="Grid_PreviewKeyDown" KeyboardNavigation.TabNavigation="None" AllowDrop="True" PreviewDrop="UserControl_Drop" PreviewDragOver="UserControl_DragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main body with History and Media Preview -->
        <Grid Grid.Row="0">
            <RichTextBox x:Name="HistoryRichTextBox" 
                         Grid.Column="0"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         Focusable="True"
                         Background="#282828" 
                         BorderThickness="0"
                         Padding="-5,0,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         FontSize="12"
                         Foreground="{StaticResource TerminalForeground}"
                         LostFocus="HistoryRichTextBox_LostFocus"
                         PreviewMouseDown="HistoryRichTextBox_PreviewMouseDown"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         RenderOptions.CachingHint="Cache">
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="CopyMenuItem_Click" />
                    </ContextMenu>
                </RichTextBox.ContextMenu>
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type FlowDocument}">
                        <Setter Property="PagePadding" Value="0"/>
                    </Style>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="TextAlignment" Value="Left"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>

        </Grid>

        <MediaElement x:Name="AudioPlayerElement" 
                      LoadedBehavior="Manual" 
                      UnloadedBehavior="Close" 
                      Visibility="Visible"
                      Width="0" Height="0" />

        <!-- Input line -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                <TextBlock x:Name="PromptStartTextBlock" Text="PS " Foreground="{StaticResource TerminalForeground}" FontSize="12" Padding="0" VerticalAlignment="Center"/>
                <ComboBox x:Name="SpaceSelector" 
                          Background="Transparent"
                          Foreground="#5A826B"
                          BorderThickness="0"
                          FontSize="12"
                          Padding="0"
                          Margin="0"
                          VerticalAlignment="Center"
                          SelectionChanged="SpaceSelector_SelectionChanged">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButton" 
                                                          Focusable="false"
                                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                          ClickMode="Press"
                                                          Cursor="Hand">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" Padding="4,0">
                                                            <!-- Subtle down arrow -->
                                                            <Path x:Name="Arrow" Fill="#5A826B" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 3.5 4 L 7 0 Z"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter TargetName="Arrow" Property="Fill" Value="#00CC66"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            
                                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="180" MaxHeight="300" Margin="0,2,0,0">
                                                    <Border x:Name="DropDownBorder" Background="#252526" BorderThickness="1" BorderBrush="#3E3E42" CornerRadius="3">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="6" ShadowDepth="2"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                    </ScrollViewer>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#CCCCCC" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#333337" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#008B8B" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="12" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="PromptEndTextBlock" Text="> " Foreground="{StaticResource TerminalForeground}" FontSize="12" Padding="0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBox x:Name="VisualTextBox" 
                     Visibility="Collapsed"
                     Grid.Column="1"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     FontSize="12"
                     Foreground="{StaticResource TerminalForeground}"
                     TextWrapping="NoWrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     VerticalAlignment="Center" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="ReplyIndicatorBorder" Grid.Row="0" Visibility="Collapsed" Background="#333337" Padding="5" Margin="0,0,0,5" CornerRadius="3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Replying to: " Foreground="#808080" FontSize="11" />
                        <TextBlock x:Name="ReplyIndicatorTextBlock" Text="" Foreground="#A0A0A0" FontSize="11" />
                        <Button Content="x" Background="Transparent" Foreground="#808080" BorderThickness="0" Margin="10,0,0,0" Padding="0" Cursor="Hand" Click="CancelReply_Click" />
                    </StackPanel>
                </Border>
                <TextBox x:Name="InputTextBox" 
                         Grid.Row="1"
                         Background="Transparent"
                         Foreground="{StaticResource TerminalForeground}"
                         CaretBrush="{StaticResource TerminalForeground}"
                         BorderThickness="0"
                         Padding="0"
                         FontSize="12"
                         TextWrapping="NoWrap"
                         AcceptsReturn="False"
                         VerticalAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         SelectionChanged="InputTextBox_SelectionChanged"
                         PreviewKeyDown="InputTextBox_PreviewKeyDown"
                         TextChanged="InputTextBox_TextChanged" />
            </Grid>
            <Popup x:Name="SuggestionsPopup"
                   PlacementTarget="{Binding ElementName=InputTextBox}"
                   Placement="Top"
                   IsOpen="False"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#1E1E1E" 
                        BorderBrush="#3E3E42" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="4"
                        Width="320"
                        MaxHeight="200">
                    <ListBox x:Name="SuggestionsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TerminalForeground}"
                             FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="SuggestionsListBox_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Command}" FontWeight="Bold" Foreground="#7A89C2" />
                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#808080" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>

        <!-- Media Preview Panel (Overlay spanning both rows) -->
        <Border Grid.RowSpan="2" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Stretch" 
                Margin="10" 
                Width="240" 
                Background="#1E1E1E" 
                BorderBrush="#3E3E42" 
                BorderThickness="1" 
                CornerRadius="5"
                x:Name="MediaPanel" 
                Visibility="Collapsed">
            <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Content Area (Image/Text/Audio) -->
                        <RowDefinition Height="Auto" /> <!-- Footer/Actions (Play/Pause, etc.) -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10" x:Name="MediaHeaderGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MediaTitleTextBlock" 
                                   Text="MEDIA PREVIEW" 
                                   Foreground="#5A826B" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="CollapseMediaButton" Grid.Column="1" Content="^" Background="Transparent" Foreground="#808080" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand" Click="CollapseMediaButton_Click"/>
                        <Button x:Name="ExpandMediaButton" Grid.Column="2" Content="v" Background="Transparent" Foreground="#808080" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand" Click="ExpandMediaButton_Click" Visibility="Collapsed"/>
                        <Button Grid.Column="3" 
                                Content="[ X ]" 
                                Background="Transparent" 
                                Foreground="#9C5B4A" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                FontWeight="Bold"
                                Click="CloseMediaPanel_Click"/>
                    </Grid>

                    <!-- Content area -->
                    <Grid Grid.Row="1">
                        <!-- Image preview -->
                        <Grid x:Name="ImagePreviewContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="ImagePreviewBorder" Grid.Row="0" Background="#111111" CornerRadius="4" MouseDown="ImagePreviewBorder_MouseDown" Cursor="Hand" ToolTip="Click to toggle zoom">
                                <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                </ScrollViewer>
                            </Border>
                            <StackPanel x:Name="ImageNavigationPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button x:Name="PrevImageButton" 
                                        Content="[ &lt; ]" 
                                        Background="Transparent" 
                                        Foreground="#7A89C2" 
                                        BorderThickness="0" 
                                        Cursor="Hand" 
                                        FontWeight="Bold"
                                        Margin="0,0,10,0"
                                        Click="PrevImageButton_Click"/>
                                <TextBlock x:Name="ImageIndexTextBlock" 
                                           Text="1 of 3" 
                                           Foreground="#A0A0A0" 
                                           FontSize="11" 
                                           VerticalAlignment="Center"/>
                                <Button x:Name="NextImageButton" 
                                        Content="[ &gt; ]" 
                                        Background="Transparent" 
                                        Foreground="#7A89C2" 
                                        BorderThickness="0" 
                                        Cursor="Hand" 
                                        FontWeight="Bold"
                                        Margin="10,0,0,0"
                                        Click="NextImageButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Audio preview (Voice Message) details -->
                        <Grid x:Name="AudioPreviewGrid" Visibility="Collapsed" Margin="0,2,0,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Line 1: Status & Duration -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock x:Name="AudioStatusTextBlock" Text="Voice Message" Foreground="#A0A0A0" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock x:Name="AudioDurationTextBlock" Text="Duration: --:--" Foreground="#808080" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Line 2: Listened CheckBox -->
                            <CheckBox x:Name="ListenedCheckBox" 
                                      Grid.Row="1"
                                      Content="Mark as Listened" 
                                      Foreground="#A0A0A0" 
                                      FontSize="11"
                                      Margin="0,3,0,0"
                                      HorizontalAlignment="Center" 
                                      IsChecked="False"
                                      Checked="ListenedCheckBox_Checked"
                                      Unchecked="ListenedCheckBox_Unchecked" />
                        </Grid>

                        <!-- Generic File/Document Details -->
                        <Grid x:Name="FilePreviewGrid" Visibility="Collapsed" Margin="0,2,0,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Line 1: Type/Name -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="FileNameTextBlock" Text="file.txt" Foreground="#808080" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="FileMimeTextBlock" Text="File Type: Unknown" Foreground="#A0A0A0" FontSize="10" TextAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- Line 2: Action button -->
                            <Button Grid.Row="1" 
                                    Content="Open File" 
                                    Background="#3E3E42" 
                                    Foreground="#A0A0A0" 
                                    BorderBrush="#555555" 
                                    BorderThickness="1" 
                                    Padding="10,4" 
                                    Cursor="Hand"
                                    FontSize="11"
                                    HorizontalAlignment="Center"
                                    Click="OpenFileButton_Click"/>
                        </Grid>
                    </Grid>

                    <!-- Audio Player Controls Footer -->
                    <Border Grid.Row="2" x:Name="AudioControlsBorder" Visibility="Collapsed" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,5,0,0" Margin="0,5,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <!-- Progress Slider & Times -->
                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="TimeElapsedTextBlock" Text="00:00" Foreground="#808080" FontSize="10" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" 
                                        x:Name="AudioProgressSlider" 
                                        Margin="5,0" 
                                        Minimum="0" 
                                        Maximum="100" 
                                        Value="0"
                                        PreviewMouseDown="AudioSlider_PreviewMouseDown"
                                        PreviewMouseUp="AudioSlider_PreviewMouseUp"
                                        IsMoveToPointEnabled="True" 
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="TimeTotalTextBlock" Text="00:00" Foreground="#808080" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Buttons + Volume Row -->
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="65" />
                                </Grid.ColumnDefinitions>
                                <!-- Play/Pause/Stop buttons on the left -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PlayButton" 
                                            Content="[Play]" 
                                            Background="Transparent" 
                                            Foreground="#5A826B" 
                                            BorderThickness="0" 
                                            Margin="0,0,6,0" 
                                            Padding="0"
                                            Cursor="Hand"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Click="PlayAudio_Click"/>
                                    <Button x:Name="PauseButton" 
                                            Content="[Pause]" 
                                            Background="Transparent" 
                                            Foreground="#9E8043" 
                                            BorderThickness="0" 
                                            Margin="0,0,6,0" 
                                            Padding="0"
                                            Cursor="Hand"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Click="PauseAudio_Click"/>
                                    <Button x:Name="StopButton" 
                                            Content="[Stop]" 
                                            Background="Transparent" 
                                            Foreground="#9C5B4A" 
                                            BorderThickness="0" 
                                            Margin="0" 
                                            Padding="0"
                                            Cursor="Hand"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Click="StopAudio_Click"/>

                                    <TextBlock Text="Speed:" Foreground="#808080" FontSize="10" Margin="10,0,3,0" VerticalAlignment="Center"/>
                                    <Button x:Name="Speed10Button" Content="1x" Background="Transparent" Foreground="#00CC66" BorderThickness="0" FontSize="10" Margin="2,0" Cursor="Hand" Click="SpeedPreset_Click"/>
                                    <Button x:Name="Speed12Button" Content="1.2x" Background="Transparent" Foreground="#808080" BorderThickness="0" FontSize="10" Margin="2,0" Cursor="Hand" Click="SpeedPreset_Click"/>
                                    <Button x:Name="Speed15Button" Content="1.5x" Background="Transparent" Foreground="#808080" BorderThickness="0" FontSize="10" Margin="2,0" Cursor="Hand" Click="SpeedPreset_Click"/>
                                    <Button x:Name="Speed20Button" Content="2x" Background="Transparent" Foreground="#808080" BorderThickness="0" FontSize="10" Margin="2,0" Cursor="Hand" Click="SpeedPreset_Click"/>
                                </StackPanel>

                                <!-- Volume icon -->
                                <TextBlock Grid.Column="1" Text="🔈" Foreground="#5A826B" VerticalAlignment="Center" Margin="5,0,3,0" FontSize="11" />
                                
                                <!-- Volume Slider -->
                                <Slider Grid.Column="2" 
                                        x:Name="VolumeSlider" 
                                        Minimum="0" Maximum="1" Value="1" 
                                        VerticalAlignment="Center"
                                        Height="18"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
        </Border>
    </Grid>
</UserControl>