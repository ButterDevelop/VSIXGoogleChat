<UserControl x:Class="VSIXGoogleChat.ChatToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="InternalPowerShell"
             FontFamily="pack://application:,,,/VSIXGoogleChat;component/Fonts/CascadiaMono.ttf#Cascadia Mono"
             FontWeight="SemiBold"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <SolidColorBrush  x:Key="TerminalForeground">#FAFAFA</SolidColorBrush>
    </UserControl.Resources>
    <Grid Margin="5" PreviewMouseDown="PreviewMouseDown" PreviewKeyDown="Grid_PreviewKeyDown" KeyboardNavigation.TabNavigation="None">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main body with History and Media Preview -->
        <Grid Grid.Row="0">
            <RichTextBox x:Name="HistoryRichTextBox" 
                         Grid.Column="0"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         Focusable="True"
                         Background="#282828" 
                         BorderThickness="0"
                         Padding="-5,0,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         FontSize="12"
                         Foreground="{StaticResource TerminalForeground}"
                         LostFocus="HistoryRichTextBox_LostFocus"
                         PreviewMouseDown="HistoryRichTextBox_PreviewMouseDown"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         RenderOptions.CachingHint="Cache">
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="CopyMenuItem_Click" />
                    </ContextMenu>
                </RichTextBox.ContextMenu>
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type FlowDocument}">
                        <Setter Property="PagePadding" Value="0"/>
                    </Style>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="TextAlignment" Value="Left"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>

        </Grid>

        <MediaElement x:Name="AudioPlayerElement" 
                      LoadedBehavior="Manual" 
                      UnloadedBehavior="Close" 
                      Visibility="Visible"
                      Width="0" Height="0" />

        <!-- Input line -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="PS> " 
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TerminalForeground}"
                       FontSize="12" 
                       Padding="0"/>

            <TextBox x:Name="VisualTextBox" 
                     Visibility="Collapsed"
                     Grid.Column="1"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     FontSize="12"
                     Foreground="{StaticResource TerminalForeground}"
                     TextWrapping="NoWrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     VerticalAlignment="Center" />

            <TextBox x:Name="InputTextBox" 
                     Grid.Column="1"
                     Background="Transparent"
                     Foreground="{StaticResource TerminalForeground}"
                     CaretBrush="{StaticResource TerminalForeground}"
                     BorderThickness="0"
                     Padding="0"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     AcceptsReturn="False"
                     VerticalAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     SelectionChanged="InputTextBox_SelectionChanged"
                     PreviewKeyDown="InputTextBox_PreviewKeyDown"
                     TextChanged="InputTextBox_TextChanged" />
        </Grid>

        <!-- Media Preview Panel (Overlay spanning both rows) -->
        <Border Grid.RowSpan="2" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Stretch" 
                Margin="10" 
                Width="240" 
                Background="#1E1E1E" 
                BorderBrush="#3E3E42" 
                BorderThickness="1" 
                CornerRadius="5"
                x:Name="MediaPanel" 
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Content Area (Image/Text/Audio) -->
                        <RowDefinition Height="Auto" /> <!-- Footer/Actions (Play/Pause, etc.) -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MediaTitleTextBlock" 
                                   Text="MEDIA PREVIEW" 
                                   Foreground="#5A826B" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" 
                                Content="[ X ]" 
                                Background="Transparent" 
                                Foreground="#9C5B4A" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                FontWeight="Bold"
                                Click="CloseMediaPanel_Click"/>
                    </Grid>

                    <!-- Content area -->
                    <Grid Grid.Row="1">
                        <!-- Image preview -->
                        <StackPanel x:Name="ImagePreviewContainer" Visibility="Collapsed">
                            <Border x:Name="ImagePreviewBorder" Background="#111111" CornerRadius="4" MouseDown="ImagePreviewBorder_MouseDown" Cursor="Hand" ToolTip="Click to toggle zoom">
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel x:Name="ImageNavigationPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button x:Name="PrevImageButton" 
                                        Content="[ &lt; ]" 
                                        Background="Transparent" 
                                        Foreground="#7A89C2" 
                                        BorderThickness="0" 
                                        Cursor="Hand" 
                                        FontWeight="Bold"
                                        Margin="0,0,10,0"
                                        Click="PrevImageButton_Click"/>
                                <TextBlock x:Name="ImageIndexTextBlock" 
                                           Text="1 of 3" 
                                           Foreground="#A0A0A0" 
                                           FontSize="11" 
                                           VerticalAlignment="Center"/>
                                <Button x:Name="NextImageButton" 
                                        Content="[ &gt; ]" 
                                        Background="Transparent" 
                                        Foreground="#7A89C2" 
                                        BorderThickness="0" 
                                        Cursor="Hand" 
                                        FontWeight="Bold"
                                        Margin="10,0,0,0"
                                        Click="NextImageButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Audio preview (Voice Message) details -->
                        <Grid x:Name="AudioPreviewGrid" Visibility="Collapsed" Margin="0,2,0,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Line 1: Status & Duration -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock x:Name="AudioStatusTextBlock" Text="Voice Message" Foreground="#A0A0A0" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock x:Name="AudioDurationTextBlock" Text="Duration: --:--" Foreground="#808080" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Line 2: Listened CheckBox -->
                            <CheckBox x:Name="ListenedCheckBox" 
                                      Grid.Row="1"
                                      Content="Mark as Listened" 
                                      Foreground="#A0A0A0" 
                                      FontSize="11"
                                      Margin="0,3,0,0"
                                      HorizontalAlignment="Center" 
                                      IsChecked="False"
                                      Checked="ListenedCheckBox_Checked"
                                      Unchecked="ListenedCheckBox_Unchecked" />
                        </Grid>

                        <!-- Generic File/Document Details -->
                        <Grid x:Name="FilePreviewGrid" Visibility="Collapsed" Margin="0,2,0,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Line 1: Type/Name -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="FileNameTextBlock" Text="file.txt" Foreground="#808080" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="FileMimeTextBlock" Text="File Type: Unknown" Foreground="#A0A0A0" FontSize="10" TextAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- Line 2: Action button -->
                            <Button Grid.Row="1" 
                                    Content="Open File" 
                                    Background="#3E3E42" 
                                    Foreground="#A0A0A0" 
                                    BorderBrush="#555555" 
                                    BorderThickness="1" 
                                    Padding="10,4" 
                                    Cursor="Hand"
                                    FontSize="11"
                                    HorizontalAlignment="Center"
                                    Click="OpenFileButton_Click"/>
                        </Grid>
                    </Grid>

                    <!-- Audio Player Controls Footer -->
                    <Border Grid.Row="2" x:Name="AudioControlsBorder" Visibility="Collapsed" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,5,0,0" Margin="0,5,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <!-- Progress Slider & Times -->
                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="TimeElapsedTextBlock" Text="00:00" Foreground="#808080" FontSize="10" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" 
                                        x:Name="AudioProgressSlider" 
                                        Margin="5,0" 
                                        Minimum="0" 
                                        Maximum="100" 
                                        Value="0"
                                        PreviewMouseDown="AudioSlider_PreviewMouseDown"
                                        PreviewMouseUp="AudioSlider_PreviewMouseUp"
                                        IsMoveToPointEnabled="True" 
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="TimeTotalTextBlock" Text="00:00" Foreground="#808080" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Buttons + Volume Row -->
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="65" />
                                </Grid.ColumnDefinitions>
                                <!-- Play/Pause/Stop buttons on the left -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PlayButton" 
                                            Content="[Play]" 
                                            Background="Transparent" 
                                            Foreground="#5A826B" 
                                            BorderThickness="0" 
                                            Margin="0,0,6,0" 
                                            Padding="0"
                                            Cursor="Hand"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Click="PlayAudio_Click"/>
                                    <Button x:Name="PauseButton" 
                                            Content="[Pause]" 
                                            Background="Transparent" 
                                            Foreground="#9E8043" 
                                            BorderThickness="0" 
                                            Margin="0,0,6,0" 
                                            Padding="0"
                                            Cursor="Hand"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Click="PauseAudio_Click"/>
                                    <Button x:Name="StopButton" 
                                            Content="[Stop]" 
                                            Background="Transparent" 
                                            Foreground="#9C5B4A" 
                                            BorderThickness="0" 
                                            Margin="0" 
                                            Padding="0"
                                            Cursor="Hand"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Click="StopAudio_Click"/>
                                </StackPanel>

                                <!-- Volume icon -->
                                <TextBlock Grid.Column="1" Text="🔈" Foreground="#5A826B" VerticalAlignment="Center" Margin="5,0,3,0" FontSize="11" />
                                
                                <!-- Volume Slider -->
                                <Slider Grid.Column="2" 
                                        x:Name="VolumeSlider" 
                                        Minimum="0" Maximum="1" Value="1" 
                                        VerticalAlignment="Center"
                                        Height="18"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>